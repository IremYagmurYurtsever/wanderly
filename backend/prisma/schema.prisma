generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(320)
  name            String        @db.VarChar(100)
  bio             String?       @db.Text
  avatarDataUrl   String?       @map("avatar_data_url") @db.Text
  phone           String?       @db.VarChar(16)
  preferences     String[]      @default([])
  journalFavorites String[]     @default([]) @map("journal_favorites")
  currency        String        @default("TRY") @db.VarChar(10)
  passwordHash    String        @map("password_hash")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  actionTokens    ActionToken[]
  sessions        Session[]
  trips           Trip[]
  memories        Memory[]
  savedPlaces     SavedPlace[]
  visas           Visa[]

  @@map("users")
}

model ActionToken {
  id        String     @id @default(uuid()) @db.Uuid
  tokenHash String     @unique @map("token_hash") @db.VarChar(64)
  kind      ActionKind
  userId    String     @map("user_id") @db.Uuid
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
  @@map("action_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Trip {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  destination String   @db.VarChar(200)
  dates       String   @db.VarChar(100)
  countryCode String?  @map("country_code") @db.VarChar(2)
  startDate   String?  @map("start_date") @db.VarChar(10)
  endDate     String?  @map("end_date") @db.VarChar(10)
  custom      Boolean  @default(true)
  notes       String?  @db.Text
  budget      String?  @db.VarChar(50)
  currency    String?  @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories    Memory[]
  stops       TripStop[]

  @@index([userId])
  @@map("trips")
}

model TripStop {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  kind      String   @db.VarChar(10)
  placeId   String   @map("place_id") @db.VarChar(512)
  title     String   @db.VarChar(200)
  address   String   @db.VarChar(500)
  mapsUrl   String   @map("maps_url") @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, kind, placeId])
  @@index([tripId])
  @@map("trip_stops")
}

model Visa {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  countryCode  String   @map("country_code") @db.VarChar(2)
  validFrom    String   @map("valid_from") @db.VarChar(10)
  durationDays Int      @map("duration_days")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("visas")
}

model Memory {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tripId     String?  @map("trip_id") @db.Uuid
  text       String   @db.Text
  placeName  String?  @map("place_name") @db.VarChar(200)
  visitedAt  String?  @map("visited_at") @db.VarChar(10)
  photoDataUrl String? @map("photo_data_url") @db.Text
  isFavorite Boolean  @default(false) @map("is_favorite")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tripId])
  @@map("memories")
}

model SavedPlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  placeId   String   @map("place_id") @db.VarChar(512)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@map("saved_places")
}

enum ActionKind {
  RESET_PASSWORD
}
